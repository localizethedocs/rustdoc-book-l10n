msgstr ""

#: src/unstable-features.md:516
msgid "`-w`/`--output-format`: output format"
msgstr ""

#: src/unstable-features.md:518
msgid "json"
msgstr ""

#: src/unstable-features.md:520
msgid ""
"Tracking Issue: [\\#76578](https://github.com/rust-lang/rust/issues/76578)"
msgstr ""

#: src/unstable-features.md:522
msgid ""
"`--output-format json` emits documentation in the experimental [JSON format]"
"(https://doc.rust-lang.org/nightly/nightly-rustc/rustdoc_json_types/)."
msgstr ""

#: src/unstable-features.md:525
