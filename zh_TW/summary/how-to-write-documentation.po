msgid "This is an example of a footnote[^note]."
msgstr ""

#: src/how-to-write-documentation.md:199
msgid ""
"This text is the contents of the footnote, which will be rendered towards "
"the bottom."
msgstr ""

#: src/how-to-write-documentation.md:202
msgid ""
"The footnotes are automatically numbered based on the order the footnotes "
"are written."
msgstr ""

